# =====================================================================
# CRM bot (Blue Fishing bot + Chatwoot) — .env.production (copiar y completar)
#   cp .env.production.example .env.production && chmod 600 .env.production
# OBLIGATORIAS (12): BOT_DOMAIN, POSTGRES_PASSWORD, OPENAI_API_KEY, VERIFY_TOKEN,
#   META_APP_SECRET, WHATSAPP_TOKEN, PHONE_NUMBER_ID, HEALTHCHECK_TOKEN, LOG_HASH_KEY,
#   ADMIN_DASHBOARD_USER, ADMIN_DASHBOARD_PASSWORD, ADMIN_SESSION_SECRET
# Todo lo demás es OPCIONAL: si queda vacío/false, ese módulo se apaga y el bot sigue funcionando.
# Secretos aleatorios: openssl rand -hex 32   (nunca pegarlos en chats ni commitearlos)
# Guía paso a paso: deploy/hostinger/SETUP.md
# =====================================================================

# Public hostname that will point to the Hostinger VPS.
# Example: bot.bluefishing.cl
BOT_DOMAIN=CHANGE_ME_bot.example.com

# Docker PostgreSQL
POSTGRES_DB=bluefishing
POSTGRES_USER=bluefishing
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# OpenAI (OBLIGATORIA: OPENAI_API_KEY)
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-6-luna
OPENAI_ENRICH_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=20000

# Meta WhatsApp Cloud API (OBLIGATORIAS: VERIFY_TOKEN, META_APP_SECRET, WHATSAPP_TOKEN, PHONE_NUMBER_ID)
# VERIFY_TOKEN: texto aleatorio que inventas tú y repites en Meta > Webhooks.
# WEBHOOK_INGRESS_SECRET: opcional, vacío = desactivado.
VERIFY_TOKEN=CHANGE_ME
WEBHOOK_INGRESS_SECRET=
META_APP_SECRET=CHANGE_ME
WHATSAPP_TOKEN=CHANGE_ME
PHONE_NUMBER_ID=CHANGE_ME
GRAPH_API_VERSION=v24.0
MAX_MESSAGE_AGE_SECONDS=300

# WooCommerce (OPCIONAL si el dueño conecta su tienda desde /panel; claves de solo lectura)
WC_URL=https://bluefishing.cl
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Traefik (Hostinger). La app NO publica puertos: Traefik llega por la red externa.
# Nombre real de la red/entrypoint/certresolver: docker network ls / config de Traefik en el VPS.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Basic auth para /panel y /admin-chat (OBLIGATORIA para docker compose). Generar con:
#   htpasswd -nB admin   (o: docker run --rm httpd:2-alpine htpasswd -nbB admin 'CLAVE')
# IMPORTANTE: en este archivo cada $ del hash debe escribirse $$ (interpolación de compose).
TRAEFIK_ADMIN_BASICAUTH_USERS=CHANGE_ME_usuario:$$2y$$05$$hash_bcrypt
# IPs/CIDR permitidas para /panel y /admin-chat (coma-separadas). Por defecto todas.
TRAEFIK_ADMIN_IP_ALLOWLIST=0.0.0.0/0,::/0

# Runtime
# Solo se usa con docker-compose.hostport.yml (alternativa con puerto en loopback).
AGENT_HOST_PORT=18080
DB_POOL_MAX=10
MAX_BODY_BYTES=1048576

# Seguridad (OBLIGATORIAS: HEALTHCHECK_TOKEN, LOG_HASH_KEY — openssl rand -hex 32)
HEALTHCHECK_TOKEN=CHANGE_ME
LOG_HASH_KEY=CHANGE_ME
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_MESSAGES=30
SECURITY_DATA_RETENTION_DAYS=30

# Token / cost governor
TOKEN_GOVERNOR_MAX_HISTORY_MESSAGES=2
TOKEN_GOVERNOR_HISTORY_CHARS=280
TOKEN_GOVERNOR_MAX_EXAMPLES=2
TOKEN_GOVERNOR_SALES_MAX_OUTPUT_TOKENS=240
TOKEN_GOVERNOR_CLASSIFIER_MAX_OUTPUT_TOKENS=460

# Dashboard /admin (OBLIGATORIAS: usuario, contraseña larga y ADMIN_SESSION_SECRET aleatorio)
ADMIN_DASHBOARD_USER=CHANGE_ME
ADMIN_DASHBOARD_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME
ADMIN_TIMEZONE=America/Santiago

# Optional AI cost display (currency units per 1M tokens)
AI_COST_CURRENCY=USD
OPENAI_INPUT_COST_PER_1M=
OPENAI_CACHED_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=

# Onboarding autoservicio multi-tenant (/panel)
# OPCIONAL. Todo este bloque puede quedar vacío: /panel se apaga y el bot funciona igual.
# URL pública https del bot. Si se deja vacía se usa https://$BOT_DOMAIN.
PUBLIC_BASE_URL=
# Clave maestra AES-256-GCM para credenciales por tenant: 32 bytes en hex (64 chars) o base64.
# Generar con: openssl rand -hex 32   — si se pierde, las credenciales guardadas no se pueden descifrar.
CREDENTIALS_MASTER_KEY=
# Secreto HMAC de sesiones del panel (mínimo 32 caracteres). openssl rand -base64 48
PANEL_SESSION_SECRET=
# Fase 2 (Embedded Signup, requiere ser Tech Provider). Apagado por defecto.
WA_EMBEDDED_SIGNUP_ENABLED=false
META_APP_ID=
META_ES_CONFIG_ID=

# Chat web (OPCIONAL): dominios donde se inserta el widget (coma-separados, con https://).
# Vacío = /chat responde 403. Ej: https://bluefishing.cl,https://www.bluefishing.cl
ALLOWED_ORIGIN=

# Atribución de ventas WooCommerce (OPCIONAL): días máximos entre la primera conversación y el pedido.
ATTRIBUTION_WINDOW_DAYS=30

# =====================================================================
# Chatwoot (mismo proyecto Compose "crm-bot"). Lo instala deploy/hostinger/install.sh.
# =====================================================================
COMPOSE_PROJECT_NAME=crm-bot
# Dominio público de Chatwoot (DNS apuntando al VPS). Ej: chat.bluefishing.cl
CHATWOOT_DOMAIN=CHANGE_ME_chat.example.com
# Vacío = https://$CHATWOOT_DOMAIN
CHATWOOT_FRONTEND_URL=
# >= v4.14 obligatorio: firma HMAC de webhooks del Agent Bot (agent_bots.secret). Verificado con v4.19.1.
CHATWOOT_IMAGE_TAG=v4.19.1
# El webhook va a la URL interna http://app:3000; SafeFetch de Chatwoot exige permitir red privada.
CHATWOOT_SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
CHATWOOT_DEFAULT_LOCALE=es
# openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME
CHATWOOT_POSTGRES_DB=chatwoot
CHATWOOT_POSTGRES_USER=chatwoot
# openssl rand -hex 32
CHATWOOT_POSTGRES_PASSWORD=CHANGE_ME
CHATWOOT_REDIS_PASSWORD=CHANGE_ME
# Cuenta y admin iniciales (el password del admin lo genera install.sh en un archivo 0600).
CHATWOOT_ACCOUNT_NAME=Blue Fishing
CHATWOOT_ADMIN_NAME=Administrador
CHATWOOT_ADMIN_EMAIL=CHANGE_ME@example.com
# SMTP (OPCIONAL: invitaciones y recuperar contraseña)
CHATWOOT_MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Integración bot <-> Chatwoot. install.sh completa CHATWOOT_BOT_TOKEN, CHATWOOT_ACCOUNT_ID
# y CHATWOOT_INBOX_ID. CHATWOOT_WEBHOOK_SECRET: openssl rand -hex 32 (firma HMAC del webhook).
CHATWOOT_ENABLED=true
# URL interna (red "chatwoot" del proyecto): el bot habla con Chatwoot sin salir del host.
CHATWOOT_BASE_URL=http://chatwoot-rails:3000
CHATWOOT_BOT_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_SECRET=CHANGE_ME
# Token del usuario agente dedicado para etiquetar "humano" en el handoff (lo completa install.sh).
CHATWOOT_LABELS_TOKEN=
# Vacío = crmbot-labels@$CHATWOOT_DOMAIN
CHATWOOT_LABELS_EMAIL=
CHATWOOT_TIMEOUT_MS=10000
# Vacío = http://app:3000/chatwoot/webhook (interna, firmada con HMAC por Chatwoot >= v4.14).
CHATWOOT_BOT_WEBHOOK_URL=

# Traefik existente (solo lectura: install.sh nunca lo modifica)
# Nombre del contenedor de Traefik para el preflight (docker ps). Vacío = autodetectar por imagen.
TRAEFIK_CONTAINER=

# Atomic CRM (OPCIONAL, Supabase cloud) — sync bot -> CRM. Desactivado por defecto.
# Además de ENABLED=true hay que levantar el servicio: docker compose --profile atomic-crm up -d. Ver deploy/atomic-crm/README.md
ATOMIC_CRM_ENABLED=false
# Ej: https://<project-ref>.supabase.co
ATOMIC_CRM_SUPABASE_URL=
# Clave SECRETA (service role / sb_secret_...) del proyecto Atomic CRM. Solo en el VPS, nunca en el frontend.
ATOMIC_CRM_SUPABASE_SECRET_KEY=
ATOMIC_CRM_SYNC_INTERVAL_SECONDS=300
ATOMIC_CRM_SYNC_LOOKBACK_DAYS=30
ATOMIC_CRM_SYNC_BATCH=200
# Opcional: id en la tabla sales de Atomic para oportunidades sin vendedor asignado.
ATOMIC_CRM_DEFAULT_SALES_ID=
