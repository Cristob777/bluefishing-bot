# Public hostname that will point to the Hostinger VPS.
# Example: bot.bluefishing.cl
BOT_DOMAIN=bot.bluefishing.cl

# Docker PostgreSQL
POSTGRES_DB=bluefishing
POSTGRES_USER=bluefishing
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ENRICH_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=20000

# Meta WhatsApp Cloud API
VERIFY_TOKEN=
WEBHOOK_INGRESS_SECRET=
META_APP_SECRET=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v24.0
MAX_MESSAGE_AGE_SECONDS=300

# WooCommerce catalog
WC_URL=https://bluefishing.cl
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Runtime
DB_POOL_MAX=10
MAX_BODY_BYTES=1048576
