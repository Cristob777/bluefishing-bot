{
  "name": "bluefishing-bot",
  "version": "1.0.0",
  "description": "Chatbot Mat\u00edas - Bluefishing.cl",
  "main": "api/webhook.js",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "csv-parse": "^5.5.6"
  },
  "scripts": {
    "build-catalogo": "node scripts/build-catalogo.js",
    "sync-catalogo": "node scripts/sync-catalogo.js",
    "enrich-catalogo": "node scripts/enrich-catalogo.js",
    "catalog:refresh": "npm run sync-catalogo && npm run enrich-catalogo",
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "security:retention": "node scripts/security-retention.js",
    "db:migrate": "for f in db/schema.sql db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "crm:sync": "node scripts/atomic-crm-sync.js --once"
  },
  "engines": {
    "node": ">=22"
  }
}
