# crm-bot (Blue Fishing bot + Chatwoot) — generado por deploy/hostinger/nginx-site.sh (PROXY_MODE=nginx)
# CRMBOT-MANAGED: archivo propio de crm-bot. No se edita ningún otro archivo de Nginx.
# Rollback: borrar este archivo, `nginx -t` y recargar (ver deploy/hostinger/SETUP.md).
# Fase 1: solo HTTP (puerto 80). Los certificados los agrega después `certbot --nginx -d ... -d ...`,
# que edita ESTE archivo (listen 443 ssl + redirect).

map $http_upgrade $crmbot_connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------- Bot: __BOT_DOMAIN__ -> 127.0.0.1:__BOT_LOCAL_PORT__ ----------
server {
    listen 80;
    listen [::]:80;
    server_name __BOT_DOMAIN__;

    client_max_body_size __BOT_MAX_BODY__;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_read_timeout 90s;

    # /panel y /admin-chat: IP allowlist + basic auth (equivalente a los middlewares de Traefik).
    location ~ ^/(panel|admin-chat)(/|$) {
__ALLOW_RULES__
        auth_basic           "crm-bot";
        auth_basic_user_file __HTPASSWD_FILE__;
        proxy_set_header Authorization "";
        proxy_pass http://127.0.0.1:__BOT_LOCAL_PORT__;
    }

    # Resto público: webhook de Meta, /chatwoot/webhook, /chat, /widget.js, /health, /admin (login propio).
    location / {
        proxy_pass http://127.0.0.1:__BOT_LOCAL_PORT__;
    }
}

# ---------- Chatwoot: __CHATWOOT_DOMAIN__ -> 127.0.0.1:__CHATWOOT_LOCAL_PORT__ ----------
server {
    listen 80;
    listen [::]:80;
    server_name __CHATWOOT_DOMAIN__;

    client_max_body_size __CHATWOOT_MAX_BODY__;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_read_timeout 90s;

    # ActionCable (tiempo real de la bandeja): websocket.
    location /cable {
        proxy_pass http://127.0.0.1:__CHATWOOT_LOCAL_PORT__;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $crmbot_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:__CHATWOOT_LOCAL_PORT__;
    }
}
