# Atomic CRM — frontend (se compila dentro del bundle; SOLO valores públicos).
# Copiar a deploy/atomic-crm/.env (ignorado por git).
ATOMIC_CRM_REPO=https://github.com/marmelab/atomic-crm.git
# Commit fijado (verificado el 13 oct 2026). Actualizar a conciencia.
ATOMIC_CRM_REF=f07d6967904e75d59dc2a7dec197449398c2d48b
SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave PUBLICABLE (sb_publishable_...). NUNCA poner aquí la clave secreta.
VITE_SB_PUBLISHABLE_KEY=
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments
# Dónde dejar el sitio estático que sirve Caddy.
ATOMIC_CRM_OUTPUT_DIR=/srv/atomic-crm
