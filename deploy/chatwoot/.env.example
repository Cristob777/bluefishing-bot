# Chatwoot (self-hosted). Copiar a .env y completar. NUNCA commitear .env.
# Referencia: https://developers.chatwoot.com/self-hosted/configuration/environment-variables
CHATWOOT_IMAGE_TAG=latest
CHATWOOT_HOST_PORT=3100

# openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
FRONTEND_URL=https://chat.bluefishing.cl
FORCE_SSL=false            # TLS lo termina el proxy
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=es

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# Correo (invitaciones a vendedores, reseteo de contraseña)
MAILER_SENDER_EMAIL=BlueFishing <soporte@bluefishing.cl>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=bluefishing.cl
