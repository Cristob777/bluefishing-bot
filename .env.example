# --- Producción WhatsApp ---
# Token arbitrario y secreto usado por Meta para verificar el endpoint GET /webhook.
VERIFY_TOKEN=
WEBHOOK_INGRESS_SECRET=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v24.0
MAX_MESSAGE_AGE_SECONDS=300

# --- OpenAI runtime ---
OPENAI_API_KEY=
# Modelo conversacional del bot. Codex se usa para construir/mantener el código,
# no como agente de ventas en runtime.
OPENAI_MODEL=gpt-6-luna
OPENAI_ENRICH_MODEL=gpt-6-luna
ENRICH_LIMIT=0
ENRICH_DELAY_MS=150
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=20000

# --- Catálogo ---
# Las claves Woo son opcionales: si faltan, el sync usa la tienda pública.
# --- WooCommerce ---
WC_URL=https://bluefishing.cl
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Bsale (RECOMENDADO): fuente de verdad del STOCK y de las VENTAS (web + tienda física).
# - Stock en vivo: antes de afirmar stock, Matías consulta Bsale por SKU (SKU WooCommerce = código
#   de variante Bsale). Sin token, Matías no afirma stock en vivo.
# - Ventas: catalog-sync trae boletas/facturas y atribuye las de clientes que hablaron con Matías.
#   Con Bsale activo, las ventas del CRM salen de Bsale (no de WooCommerce): sin doble conteo.
# Token: en la cuenta Bsale, configuración de API / integraciones (si no aparece, pedirlo a soporte
# Bsale). Da acceso completo a la cuenta: el bot solo hace GET, nunca escribe. No se imprime en logs.
# Verificar: docker compose --env-file .env.production exec -T app node scripts/bsale-check.js
BSALE_ACCESS_TOKEN=
# Sucursales cuyo stock cuenta (IDs coma-separados; vacío = todas). Los IDs los muestra bsale-check.js
BSALE_OFFICE_IDS=
BSALE_STOCK_CACHE_SECONDS=120
# Días de historial en la primera sincronización de ventas
BSALE_SALES_BACKFILL_DAYS=30

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chat web (POST /chat + GET /widget.js). Orígenes autorizados, coma-separados.
# Vacío = chat web deshabilitado (403).
ALLOWED_ORIGIN=

# Onboarding autoservicio (/panel) — ver README "Onboarding autoservicio"
PUBLIC_BASE_URL=
CREDENTIALS_MASTER_KEY=
PANEL_SESSION_SECRET=
WA_EMBEDDED_SIGNUP_ENABLED=false
META_APP_ID=
META_ES_CONFIG_ID=
