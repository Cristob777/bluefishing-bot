# Token para verificar el webhook de WhatsApp (el que pones en Meta)
VERIFY_TOKEN=

# IA: este flujo usa Claude
CLAUDE_API_KEY=

# WhatsApp Business API (Meta for Developers)
# Los números que pueden RECIBIR mensajes se configuran en Meta (API Setup → "A" / lista de destinatarios).
# Aquí solo va el token y el ID del número desde el que envías.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Para test local (test-chat-local.js): debe ser uno de los números que tienes en la lista de Meta.
# Ejemplo Chile: 56912345678 (sin +). Sin esto, el script usa 17863559966 y Meta rechaza (no está en la lista).
TEST_FROM=

# Sync del catálogo (scripts/sync-catalogo.js, npm run sync-catalogo)
# Generar en WooCommerce → Ajustes → Avanzado → REST API → Agregar clave (permisos: Lectura)
WC_URL=https://bluefishing.cl
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Supabase — catálogo entrenable (interfaz /admin) + espejo de productos
# Project Settings → API en el dashboard de Supabase.
SUPABASE_URL=
# Anon/public key: se expone en el HTML de /admin a propósito (así funciona
# el cliente de Supabase en el navegador). El acceso real lo protege RLS +
# login individual, no el secreto de esta key.
SUPABASE_ANON_KEY=
# Service role key: SOLO se usa server-side (sync-catalogo.js). Nunca exponer
# en el navegador ni en /admin — bypassa RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=
