# --- Producción WhatsApp ---
# Token arbitrario y secreto usado por Meta para verificar el endpoint GET /webhook.
VERIFY_TOKEN=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v24.0
MAX_MESSAGE_AGE_SECONDS=300

# --- OpenAI runtime ---
OPENAI_API_KEY=
# Modelo conversacional del bot. Codex se usa para construir/mantener el código,
# no como agente de ventas en runtime.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=20000

# --- WooCommerce ---
WC_URL=https://bluefishing.cl
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# El widget web queda fuera del scope de producción WhatsApp por ahora.
ALLOWED_ORIGIN=
